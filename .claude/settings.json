{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(//Users/**/.claude/CLAUDE.md)",
      "Write(./CLAUDE.local.md)",
      "Edit(./CLAUDE.local.md)"
    ],
    "allow": [
      "Write(./.claude/memory/**)",
      "Edit(./.claude/memory/**)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(tesseract:*)"
    ]
  }
}
