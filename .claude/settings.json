{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(//Users/**/.claude/CLAUDE.md)",
      "Write(./CLAUDE.local.md)",
      "Edit(./CLAUDE.local.md)"
    ],
    "allow": [
      "Edit(./.claude/memory/**)",
      "Write",
      "Read",
      "WebFetch",
      "Bash"
    ]
  }
}
